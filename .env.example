# Copy to .env, fill in real values, never commit .env itself.
# These must be exported into the shell environment before `./mvnw spring-boot:run`
# (e.g. `export $(grep -v '^#' .env | xargs)`), or set via your IDE's run configuration.

# HS256 signing key for access tokens, base64-encoded, must decode to >= 32 bytes.
# Generate locally with: openssl rand -base64 32
JWT_SECRET=

# Resend API key (https://resend.com) - used to send the email verification link.
RESEND_API_KEY=
