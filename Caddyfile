{
	servers {
		# Seule la passerelle du VPS (reseau Docker "gateway", donc IP privee) parle a
		# ce conteneur : on lui fait confiance pour l'IP client qu'elle transmet dans
		# X-Forwarded-For. {client_ip} vaut alors cette IP, sinon l'IP de la connexion.
		trusted_proxies static private_ranges
	}
}

:80 {
	# Les reponses de Spring ont deja ces en-tetes (Spring Security), mais pas les
	# fichiers statiques du frontend servis directement par Caddy.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	handle /api/* {
		reverse_proxy backend:8080 {
			# Une seule valeur, l'IP du vrai client : le rate limiting de Spring
			# (ForwardedHeaderFilter -> getRemoteAddr) partitionne dessus.
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Une build par langue (Angular i18n, plans/done/i18n.md) : /en/ et /fr/, chacune
	# avec son index.html pour les routes de l'application.
	@en path /en /en/*
	handle @en {
		root * /srv
		try_files {path} /en/index.html
		file_server
	}

	@fr path /fr /fr/*
	handle @fr {
		root * /srv
		try_files {path} /fr/index.html
		file_server
	}

	# Langue d'une URL sans prefixe ("/", anciens liens, liens d'emails) : le choix fait
	# sur le site (cookie ageguessr_lang), sinon la langue du navigateur, sinon l'anglais.
	map {http.request.header.Accept-Language} {browser_lang} {
		~^fr fr
		default en
	}
	map {http.request.cookie.ageguessr_lang} {site_lang} {
		en en
		fr fr
		default {browser_lang}
	}

	# Les anciennes pages legales en ?lang=fr gardent leur langue.
	@legacyFrench query lang=fr
	handle @legacyFrench {
		header Cache-Control "no-store"
		redir * /fr{path} 302
	}

	# 302 et no-store : la reponse depend du visiteur (cookie, navigateur), Cloudflare ne
	# doit pas servir a tous la redirection d'un seul. {uri} garde le chemin et la query
	# (?token= des liens d'emails).
	handle {
		header Cache-Control "no-store"
		header Vary "Cookie, Accept-Language"
		redir * /{site_lang}{uri} 302
	}
}
